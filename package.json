{
  "name": "shopee-openai-mbti-closet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && npm start",
    "dev:frontend": "next dev",
    "dev:vercel": "CLOSET_TARGET=vercel next dev --webpack",
    "build": "next build --webpack && node scripts/build-sites.mjs",
    "build:vercel": "CLOSET_TARGET=vercel next build --webpack",
    "start:vercel": "CLOSET_TARGET=vercel next start",
    "prestart": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "start": "wrangler dev --config wrangler.local.jsonc",
    "lint": "eslint",
    "test:storage": "node --test tests/storage-isolation.test.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@supabase/supabase-js": "^2.119.2",
    "fast-png": "^8.0.0",
    "heic-to": "^1.6.7",
    "jpeg-js": "^0.4.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  }
}
