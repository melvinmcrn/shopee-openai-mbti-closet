{
  "name": "mbti-closet-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./Shopee Database/clothes_image_database",
    "binding": "CATALOG_ASSETS",
    "run_worker_first": true
  },
  "dev": { "ip": "localhost", "port": 3000 },
  "vars": { "LOCAL_DEV": "1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mbti-closet-local",
      "database_id": "a64bf2be-5f33-4a1a-8e77-c35fd908d446",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "mbti-closet-local" }
  ]
}
